---
/**
 * Asymmetric hero: copy on ~55% of the container, visual on the rest — the visual
 * runs past the container edge to the viewport (to the left on RTL pages, since
 * the grid follows `dir`). Marked `data-hero` so the Navbar knows when to blur.
 *
 * All text comes in through props (fed from src/content/business.yaml).
 * Without an `image`, a clearly marked [CLIENT PHOTO NEEDED] placeholder renders.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Link {
	label: string;
	href: string;
}

interface Fact {
	/** Short and concrete: "Seit 1987", "4,9 / 5", "45 Min." */
	value: string;
	label: string;
}

interface Props {
	/** Small line above the headline — e.g. trade + service area. */
	eyebrow?: string;
	headline: string;
	lede?: string;
	cta: Link;
	secondaryCta?: Link;
	/** Up to three hard facts shown under the CTAs. */
	facts?: Fact[];
	image?: ImageMetadata;
	imageAlt?: string;
	/** What the client photo should show. Rendered inside the placeholder. */
	imageBrief?: string;
	/** Solid block overlapping the photo's inner edge — one strong number. */
	badge?: Fact;
}

const { eyebrow, headline, lede, cta, secondaryCta, facts = [], image, imageAlt = "", imageBrief, badge } = Astro.props;
---

<section data-hero class="hero-grid relative overflow-x-clip pt-10 pb-16 sm:pt-14 lg:py-0">
	<div class="hero-copy flex flex-col justify-center lg:py-20 lg:pe-16 xl:pe-24">
		{eyebrow && <p class="mb-6 text-sm font-semibold tracking-[0.14em] text-brand uppercase">{eyebrow}</p>}

		<h1 class="font-display text-[clamp(2.75rem,4vw+1.25rem,5rem)] leading-[0.98] font-medium tracking-[-0.025em] text-balance text-ink">
			{headline}
		</h1>

		{lede && <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-pretty text-ink/70 sm:text-xl">{lede}</p>}

		<div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-4">
			<a
				href={cta.href}
				class="inline-flex items-center rounded-full bg-brand px-7 py-4 text-base font-semibold text-brand-ink transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
			>
				{cta.label}
			</a>
			{
				secondaryCta && (
					<a
						href={secondaryCta.href}
						class="text-base font-semibold text-ink underline decoration-ink/25 decoration-1 underline-offset-[6px] transition-colors hover:decoration-ink"
					>
						{secondaryCta.label}
					</a>
				)
			}
		</div>

		{
			facts.length > 0 && (
				<dl class="mt-12 grid auto-cols-fr grid-flow-col border-t border-ink/15 pt-7 sm:flex sm:flex-wrap sm:gap-y-6">
					{facts.slice(0, 3).map((fact) => (
						<div class="flex flex-col-reverse justify-end not-last:me-4 not-last:border-e not-last:border-ink/15 not-last:pe-4 sm:not-last:me-8 sm:not-last:pe-8">
							<dt class="mt-1 text-[0.8125rem] leading-snug text-ink/60 sm:text-sm">{fact.label}</dt>
							<dd class="font-display text-2xl font-medium sm:text-3xl tracking-tight text-ink"><bdi>{fact.value}</bdi></dd>
						</div>
					))}
				</dl>
			)
		}
	</div>

	<div class="hero-visual relative mt-12 lg:mt-0">
		<div class="relative aspect-[4/3] h-full overflow-hidden rounded-ss-[2.5rem] sm:aspect-[16/10] lg:aspect-auto lg:min-h-[min(46rem,calc(100svh-4.5rem))]">
			{
				image ? (
					<Image
						src={image}
						alt={imageAlt}
						widths={[640, 960, 1280, 1600, 2000]}
						sizes="(min-width: 64rem) 50vw, 100vw"
						loading="eager"
						fetchpriority="high"
						class="absolute inset-0 size-full object-cover"
					/>
				) : (
					<div class="hatch absolute inset-0 flex flex-col items-start justify-start gap-2 p-8 text-ink/60 sm:p-10">
						<p class="font-mono text-sm font-semibold tracking-wide text-ink/80">[CLIENT PHOTO NEEDED]</p>
						{imageBrief && <p class="max-w-sm text-sm leading-relaxed">{imageBrief}</p>}
					</div>
				)
			}
		</div>

		{
			badge && (
				<div class="absolute -bottom-8 start-5 max-w-[15rem] bg-brand px-6 py-5 text-brand-ink sm:start-8 lg:bottom-14 lg:-start-12">
					<p class="font-display text-4xl leading-none font-medium tracking-tight"><bdi>{badge.value}</bdi></p>
					<p class="mt-2 text-sm leading-snug opacity-85">{badge.label}</p>
				</div>
			)
		}
	</div>
</section>

<style>
	/*
	 * Column lines mirror the Navbar container (max-w-7xl, px-5 / sm:px-8), so the copy
	 * aligns with the logo while the visual runs to the viewport edge.
	 */
	.hero-grid {
		--gutter: 1.25rem;
		--edge: max(var(--gutter), (100% - 80rem) / 2 + var(--gutter));
		display: grid;
		grid-template-columns: [full-start] var(--edge) [content-start] minmax(0, 1fr) [content-end] var(--edge) [full-end];
	}

	.hero-copy {
		grid-column: content;
	}

	/* Mobile: keeps the start gutter, bleeds off the end edge. */
	.hero-visual {
		grid-column: content-start / full-end;
	}

	@media (min-width: 40rem) {
		.hero-grid {
			--gutter: 2rem;
		}
	}

	@media (min-width: 64rem) {
		.hero-grid {
			grid-template-columns:
				[full-start] var(--edge)
				[content-start] minmax(0, 11fr)
				[split] minmax(0, 9fr)
				[content-end] var(--edge)
				[full-end];
		}

		.hero-copy {
			grid-column: content-start / split;
			grid-row: 1;
		}

		.hero-visual {
			grid-column: split / full-end;
			grid-row: 1;
		}
	}
</style>
