---
/**
 * Sticky site header. Transparent at first; gains a blurred backdrop once the element
 * marked `data-hero` has scrolled out from under it. Pages without a `data-hero`
 * element fall back to switching as soon as the page scrolls.
 *
 * All text comes in through props (fed from src/content/business.yaml) — nothing
 * client-specific lives here.
 */

interface NavLink {
	label: string;
	href: string;
}

interface Props {
	/** Business name: shown as a wordmark when there's no logo, and used as the logo's alt text. */
	brandName: string;
	/** Accepts an imported image (ImageMetadata) or a plain { src, width, height } object. */
	logo?: { src: string; width: number; height: number };
	homeHref?: string;
	links: NavLink[];
	cta: NavLink;
	/** Accessible labels for the mobile toggle — pass translations on non-German pages. */
	menuOpenLabel?: string;
	menuCloseLabel?: string;
	navLabel?: string;
}

const {
	brandName,
	logo,
	homeHref = "/",
	links,
	cta,
	menuOpenLabel = "Menü öffnen",
	menuCloseLabel = "Menü schließen",
	navLabel = "Hauptnavigation",
} = Astro.props;

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isCurrent = (href: string) => href.startsWith("/") && normalize(href) === currentPath;
---

<header
	data-navbar
	class="group/nav sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300 ease-out data-[scrolled]:border-ink/10 data-[scrolled]:bg-paper/75 data-[scrolled]:backdrop-blur-md data-[open]:border-ink/10 data-[open]:bg-paper motion-reduce:transition-none"
>
	<div class="mx-auto flex h-18 max-w-7xl items-center gap-6 px-5 sm:px-8">
		<a href={homeHref} class="me-auto flex shrink-0 items-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand">
			{
				logo ? (
					<img src={logo.src} width={logo.width} height={logo.height} alt={brandName} class="h-9 w-auto" />
				) : (
					<span class="font-display text-xl font-semibold tracking-tight text-ink">{brandName}</span>
				)
			}
		</a>

		<nav aria-label={navLabel} class="hidden md:block">
			<ul class="flex items-center gap-7">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isCurrent(link.href) ? "page" : undefined}
								class="relative py-2 text-[0.9375rem] font-medium text-ink/75 transition-colors hover:text-ink aria-[current=page]:text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform hover:after:scale-x-100 aria-[current=page]:after:scale-x-100 rtl:after:origin-right"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a
			href={cta.href}
			class="hidden rounded-full bg-brand px-5 py-2.5 text-[0.9375rem] font-semibold text-brand-ink transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:inline-flex"
		>
			{cta.label}
		</a>

		<button
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label={menuOpenLabel}
			data-label-open={menuOpenLabel}
			data-label-close={menuCloseLabel}
			class="-me-2 grid size-11 place-items-center rounded-full text-ink focus-visible:outline-2 focus-visible:outline-brand md:hidden"
		>
			<span aria-hidden="true" class="relative block h-3 w-5">
				<span class="absolute inset-x-0 top-0 h-0.5 rounded-full bg-current transition-transform duration-200 group-data-[open]/nav:translate-y-[5px] group-data-[open]/nav:rotate-45"></span>
				<span class="absolute inset-x-0 bottom-0 h-0.5 rounded-full bg-current transition-transform duration-200 group-data-[open]/nav:-translate-y-[5px] group-data-[open]/nav:-rotate-45"></span>
			</span>
		</button>
	</div>

	<div id="mobile-nav" hidden class="border-t border-ink/10 md:hidden">
		<nav aria-label={navLabel} class="mx-auto max-w-7xl px-5 pt-4 pb-8 sm:px-8">
			<ul class="flex flex-col">
				{
					links.map((link) => (
						<li class="border-b border-ink/10">
							<a
								href={link.href}
								aria-current={isCurrent(link.href) ? "page" : undefined}
								class="block py-4 font-display text-2xl text-ink aria-[current=page]:text-brand"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<a
				href={cta.href}
				class="mt-8 flex w-full items-center justify-center rounded-full bg-brand px-5 py-3.5 font-semibold text-brand-ink"
			>
				{cta.label}
			</a>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>("[data-navbar]");
	const toggle = header?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
	const panel = header?.querySelector<HTMLElement>("#mobile-nav");

	if (header) {
		const setScrolled = (scrolled: boolean) => header.toggleAttribute("data-scrolled", scrolled);
		const hero = document.querySelector<HTMLElement>("[data-hero]");

		if (hero) {
			// "Past the hero" = the hero's bottom edge has moved above the header's bottom edge.
			let observer: IntersectionObserver | undefined;
			const observe = () => {
				observer?.disconnect();
				observer = new IntersectionObserver(([entry]) => setScrolled(!entry.isIntersecting), {
					rootMargin: `-${header.offsetHeight}px 0px 0px 0px`,
				});
				observer.observe(hero);
			};
			observe();
			window.addEventListener("resize", observe, { passive: true });
		} else {
			const onScroll = () => setScrolled(window.scrollY > 8);
			onScroll();
			window.addEventListener("scroll", onScroll, { passive: true });
		}
	}

	if (header && toggle && panel) {
		const setOpen = (open: boolean) => {
			panel.hidden = !open;
			header.toggleAttribute("data-open", open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "");
		};

		toggle.addEventListener("click", () => setOpen(panel.hidden));
		panel.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) setOpen(false);
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && !panel.hidden) {
				setOpen(false);
				toggle.focus();
			}
		});
		window.matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>
